{
  "name": "yoshida-taisei-profile",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "GitHub profile README with an auto-updating Premier League standings SVG.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "generate": "node scripts/generate-standings.mjs",
    "generate:sample": "node scripts/generate-standings.mjs --fixture scripts/fixtures/standings.sample.json",
    "generate:fixtures": "node scripts/generate-fixtures.mjs",
    "generate:fixtures:sample": "node scripts/generate-fixtures.mjs --fixture scripts/fixtures/matches.sample.json",
    "fetch-crests": "node scripts/fetch-crests.mjs"
  }
}
