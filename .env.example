# Copy this file to .env and paste your token. .env is gitignored - the real
# token must never be committed.
#
#   cp .env.example .env
#
# Football-data.org API token (free tier covers the Premier League table).
# Register: https://www.football-data.org/client/register
# The same value also has to be added as the repository secret
# FOOTBALL_DATA_API_TOKEN for the scheduled GitHub Actions run.
FOOTBALL_DATA_API_TOKEN=
